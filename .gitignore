*.pcap
*.pcap.gz
analysis/*.log
logging/logs/
honeynet/logs/
honeynet/**/*.log
listener/zeek/logs/

# Elasticsearch data volume (if ever bind-mounted)
esdata/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# macOS
.DS_Store

# Editor
.vscode/
*.swp

# Secrets / local env
.env
*.key
*.pem

# Generated artifacts and synthetic stand-in data (regenerable from the scripts)
*.joblib
ai/swat_like.csv
# the real HAI 21.03 files sit next to hai_detector.py but stay out of git:
